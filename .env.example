# Copier ce fichier en .env.local (développement) et renseigner les mêmes variables dans Vercel
# (Project → Settings → Environment Variables). Ne jamais committer de vraies valeurs.

# Domaine public du site (balises canoniques, hreflang, sitemap). Sans valeur : https://arrow-home.vercel.app
NEXT_PUBLIC_SITE_URL=https://www.exemple.com

# --- Enregistrement des demandes (Supabase) — SERVEUR UNIQUEMENT, jamais de préfixe NEXT_PUBLIC_ ---
# Project Settings → API : URL du projet et clé « service_role » (ou nouvelle clé secrète sb_secret_…)
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=a-renseigner-dans-vercel-uniquement

# Sel secret pour l'empreinte des adresses IP (limitation de fréquence). Générer : openssl rand -hex 32
LEAD_IP_SALT=a-generer

# --- Notification e-mail (facultatif, via https://resend.com) ---
RESEND_API_KEY=
# Adresse d'expédition sur un domaine vérifié chez Resend, ex. "Site Arrow Home <site@arrowhome.cc>"
LEAD_NOTIFY_FROM=
# Destinataires, séparés par des virgules
LEAD_NOTIFY_TO=info@arrowhome.cc
